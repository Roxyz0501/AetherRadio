<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><PlatformTarget>x64</PlatformTarget>
    <AssemblyName>AetherRadio</AssemblyName><RootNamespace>AetherRadio</RootNamespace>
    <Title>BGMPlayer</Title><Product>BGMPlayer</Product>
    <Authors>Roxyz0501</Authors><Version>0.1.5.0</Version>
    <RepoUrl>https://github.com/Roxyz0501/AetherRadio</RepoUrl>
    <IconUrl>https://raw.githubusercontent.com/Roxyz0501/AetherRadio/main/images/icon.png</IconUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Deterministic>true</Deterministic><IsPackable>false</IsPackable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DalamudLibPath Condition="'$(DalamudLibPath)' == ''">$(APPDATA)\XIVLauncher\addon\Hooks\dev\</DalamudLibPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <None Include="../images/icon.png" Link="icon.png" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Data/*.csv" LogicalName="AetherRadio.Data.%(Filename)%(Extension)" />
    <None Include="../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../licenses/*.txt" Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
